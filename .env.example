# ==========================================
# Embedding Service 环境变量配置
# ==========================================

# --- 包装服务基础配置 ---
WRAPPER_PORT=17999
WRAPPER_HOST=0.0.0.0

# --- 缓存配置 ---
WRAPPER_CACHE_ENABLED=true
WRAPPER_CACHE_MAX_SIZE=1000
WRAPPER_CACHE_TTL_SECONDS=3600

# --- 上游服务地址 ---
WRAPPER_EMBEDDING_SERVICE_URL=http://localhost:18000
WRAPPER_LLM_SERVICE_URL=http://localhost:18001

# --- SurrealDB 连接配置 ---
WRAPPER_SURREALDB_URL=ws://localhost:8000/rpc
WRAPPER_SURREALDB_NAMESPACE=memory_ns
WRAPPER_SURREALDB_DATABASE=memory_db

# --- SurrealDB 凭据配置（Phase 3C 安全加固）---
# 迁移用户（OWNER 权限，用于 schema 初始化/升级）
WRAPPER_SURREALDB_USERNAME=root
WRAPPER_SURREALDB_PASSWORD=root

# 运行时用户（EDITOR 权限，仅数据操作）
WRAPPER_SURREALDB_RUNTIME_USERNAME=runtime_user
WRAPPER_SURREALDB_RUNTIME_PASSWORD=change_me_in_production

# 是否启用运行时凭据（生产环境建议 true）
WRAPPER_SURREALDB_USE_RUNTIME_CREDENTIALS=true

# --- 搜索配置（SurrealDB 3.0 HNSW + BM25）---
# 阈值配置
WRAPPER_SEARCH_VECTOR_THRESHOLD=0.75
WRAPPER_SEARCH_HYBRID_THRESHOLD=0.75
WRAPPER_SEARCH_KEYWORD_THRESHOLD=0.0

# RRF 混合搜索参数
WRAPPER_SEARCH_RRF_K=60
WRAPPER_SEARCH_RRF_VECTOR_WEIGHT=0.7
WRAPPER_SEARCH_RRF_KEYWORD_WEIGHT=0.3

# HNSW 查询参数
WRAPPER_SEARCH_HNSW_EF_SEARCH=50

# 多租户默认值
WRAPPER_DEFAULT_TENANT_ID=default

# --- OpenTelemetry 分布式追踪（Phase 3B）---
WRAPPER_OTEL_ENABLED=false
WRAPPER_OTEL_SERVICE_NAME=embedding-wrapper
WRAPPER_OTEL_ENDPOINT=http://localhost:4317
WRAPPER_OTEL_SAMPLE_RATE=1.0

# --- HTTP 连接池配置 ---
WRAPPER_HTTP_MAX_CONNECTIONS=100
WRAPPER_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
WRAPPER_HTTP_TIMEOUT=30.0
WRAPPER_HTTP_CONNECT_TIMEOUT=5.0
WRAPPER_HTTP_MAX_RETRIES=3

# --- WebSocket 认证（Phase 3 优化）---
# 可选：配置 WebSocket token 启用认证
# 如果不配置，则允许所有连接（向后兼容）
WRAPPER_WEBSOCKET_TOKEN=
